generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  SCHOOL
  COACHING
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

model Organization {
  id          String           @id @default(cuid())
  name        String
  type        OrganizationType
  slug        String           @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  invitations TeamInvitation[]
  teamAudit TeamAudit[]
  memberships Membership[]
  students    Student[]
  groups      Group[]
  feeCharges  FeeCharge[]
  attendance Attendance[]
  studentAdmissionCounter StudentAdmissionCounter?
}

model Membership {
  organizationId String
  clerkUserId    String
  role           MembershipRole
  revision       String @default(uuid()) @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, clerkUserId])
  @@index([clerkUserId])
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

model Student {
  feeCharges      FeeCharge[]
  attendance Attendance[]
  id              String        @id @default(cuid())
  organizationId  String
  groupId         String?
  group           Group? @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  admissionNumber String
  name            String
  guardianName    String
  guardianPhone   String?
  status          StudentStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, groupId])
  @@unique([organizationId, id])
  @@unique([organizationId, admissionNumber])
  @@index([organizationId, createdAt])
}

model StudentAdmissionCounter {
  organizationId String @id
  lastNumber Decimal @default(0) @db.Decimal(65, 0)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum GroupStatus {
  ACTIVE
  INACTIVE
}

// Case-insensitive normalized name/section uniqueness is enforced by the
// expression index Group_organization_name_section_key in the SQL migration.
model Group {
  students       Student[]
  attendance Attendance[]
  @@unique([organizationId, id])
  id             String @id @default(cuid())
  organizationId String
  name           String @db.VarChar(100)
  section        String @default("") @db.VarChar(60)
  status         GroupStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
}

model FeeCharge {
  payments             FeePayment[]
  @@unique([organizationId, id])
  id                   String @id @default(cuid())
  organizationId       String
  studentId            String
  title                String @db.VarChar(150)
  amountPaise          Int
  dueDate              DateTime @db.Date
  createdAt            DateTime @default(now())
  createdByClerkUserId  String
  submissionKey        String @db.Uuid
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  student              Student @relation(fields: [organizationId, studentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, submissionKey])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, studentId, dueDate])
}

enum FeePaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
}

model FeePayment {
  id                    String @id @default(cuid())
  organizationId        String
  feeChargeId           String
  amountPaise           Int
  paymentDate           DateTime @db.Date
  method                FeePaymentMethod
  reference             String? @db.VarChar(100)
  note                  String? @db.VarChar(500)
  recordedByClerkUserId  String
  createdAt             DateTime @default(now())
  submissionKey         String @db.Uuid
  feeCharge             FeeCharge @relation(fields: [organizationId, feeChargeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, submissionKey])
  @@index([organizationId, feeChargeId, createdAt, id])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Attendance {
  id                       String @id @default(cuid())
  organizationId           String
  studentId                String
  groupId                  String
  date                     DateTime @db.Date
  status                   AttendanceStatus
  version                  Int @default(1)
  recordedByClerkUserId     String
  lastUpdatedByClerkUserId  String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [organizationId, studentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  group Group @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, studentId, date])
  @@index([organizationId, groupId, date])
}


enum TeamInviteRole {
  ADMIN
  STAFF
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum TeamAuditEvent {
  INVITED
  INVITE_REVOKED
  INVITE_ACCEPTED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
}

// One pending invite per organization/email is enforced by a partial SQL index.
model TeamInvitation {
  id String @id @default(cuid())
  organizationId String
  email String @db.VarChar(254)
  role TeamInviteRole
  tokenHash String @unique @db.Char(64)
  status TeamInvitationStatus @default(PENDING)
  expiresAt DateTime
  createdByClerkUserId String
  acceptedByClerkUserId String?
  acceptedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt, id])
}

model TeamAudit {
  id String @id @default(cuid())
  organizationId String
  actorClerkUserId String
  event TeamAuditEvent
  targetClerkUserId String?
  invitationId String?
  previousRole MembershipRole?
  nextRole MembershipRole?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt, id])
}
