generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  SCHOOL
  COACHING
}

enum MembershipRole {
  OWNER
  ADMIN
  STAFF
}

model Organization {
  id          String           @id @default(cuid())
  name        String
  type        OrganizationType
  slug        String           @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships Membership[]
  students    Student[]
  groups      Group[]
  studentAdmissionCounter StudentAdmissionCounter?
}

model Membership {
  organizationId String
  clerkUserId    String
  role           MembershipRole
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, clerkUserId])
  @@index([clerkUserId])
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

model Student {
  id              String        @id @default(cuid())
  organizationId  String
  groupId         String?
  group           Group? @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  admissionNumber String
  name            String
  guardianName    String
  guardianPhone   String?
  status          StudentStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, groupId])
  @@unique([organizationId, admissionNumber])
  @@index([organizationId, createdAt])
}

model StudentAdmissionCounter {
  organizationId String @id
  lastNumber Decimal @default(0) @db.Decimal(65, 0)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum GroupStatus {
  ACTIVE
  INACTIVE
}

// Case-insensitive normalized name/section uniqueness is enforced by the
// expression index Group_organization_name_section_key in the SQL migration.
model Group {
  students       Student[]
  @@unique([organizationId, id])
  id             String @id @default(cuid())
  organizationId String
  name           String @db.VarChar(100)
  section        String @default("") @db.VarChar(60)
  status         GroupStatus @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
}
